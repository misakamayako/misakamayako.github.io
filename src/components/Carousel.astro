---
import {Image} from "astro:assets";
import type {ImageMetadata} from "astro";

interface Slide {
    src: ImageMetadata;
    alt?: string;
}

interface Props {
    slides: Slide[];
    label?: string;
}

const {slides, label = "图片"} = Astro.props;

/** 随笔正文栏宽是 44rem（704px），按此生成候选宽度，且不超过原图宽度 */
const widthsFor = (src: ImageMetadata) => {
    const candidates = [448, 704, 1408].filter((w) => w <= src.width);
    return candidates.length > 0 ? candidates : [src.width];
};
---

<div class="snap-gallery" role="group" aria-roledescription="轮播图" aria-label={label} data-gallery>
    <div class="snap-track" data-track tabindex="0">
        {
            slides.map((slide, i) => (
                <figure class="snap-slide">
                    <Image
                        src={slide.src}
                        alt={slide.alt ?? ""}
                        widths={widthsFor(slide.src)}
                        sizes="(max-width: 768px) 100vw, 704px"
                        loading={i === 0 ? "eager" : "lazy"}
                    />
                    {slide.alt ? <figcaption>{slide.alt}</figcaption> : null}
                </figure>
            ))
        }
    </div>

    <div class="snap-controls">
        <button type="button" data-prev aria-label="上一张">‹</button>
        <div class="snap-dots">
            {
                slides.map((slide, i) => (
                    <button
                        type="button"
                        data-dot={i}
                        aria-label={`第 ${i + 1} 张：${slide.alt ?? ""}`}
                        aria-current={i === 0 ? "true" : "false"}
                    />
                ))
            }
        </div>
        <button type="button" data-next aria-label="下一张">›</button>
    </div>
</div>

<style>
    .snap-gallery {
        margin-block: 2.5rem;
    }

    /* 关键：横向滚动容器 + 强制吸附 */
    .snap-track {
        display: flex;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        border-radius: 0.75rem;
    }

    .snap-track::-webkit-scrollbar {
        display: none;
    }

    .snap-track:focus-visible {
        outline: 2px solid var(--color-violet-400);
        outline-offset: 3px;
    }

    /* 每张占满一屏；内边距不会改变外框宽度，索引换算因此保持精确 */
    .snap-slide {
        flex: 0 0 100%;
        box-sizing: border-box;
        margin: 0;
        padding-inline: 0.25rem;
        scroll-snap-align: center;
        scroll-snap-stop: always;
    }

    .snap-slide :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.75rem;
        background: rgb(15 23 42 / 0.5);
    }

    .snap-slide figcaption {
        margin-top: 0.55rem;
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--color-slate-400);
        text-align: center;
    }

    .snap-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        margin-top: 0.9rem;
    }

    [data-prev],
    [data-next] {
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--color-slate-600);
        border-radius: 9999px;
        background: rgb(51 65 85 / 0.6);
        color: var(--color-zinc-200);
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    [data-prev]:hover,
    [data-next]:hover {
        background: rgb(71 85 105 / 0.85);
        border-color: var(--color-slate-500);
    }

    .snap-dots {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    [data-dot] {
        width: 0.5rem;
        height: 0.5rem;
        padding: 0;
        border: none;
        border-radius: 9999px;
        background: var(--color-slate-600);
        cursor: pointer;
        transition: width 0.2s ease, background-color 0.15s ease;
    }

    [data-dot][aria-current="true"] {
        width: 1.25rem;
        background: var(--color-violet-400);
    }

    @media (prefers-reduced-motion: reduce) {
        .snap-track {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
        const track = gallery.querySelector<HTMLElement>("[data-track]");
        const dots = [...gallery.querySelectorAll<HTMLButtonElement>("[data-dot]")];
        if (!track || dots.length === 0) return;

        // 每张 slide 正好等于容器宽度，所以索引可以直接换算
        const step = () => track.clientWidth;
        const current = () => Math.round(track.scrollLeft / Math.max(1, step()));

        const goTo = (i: number) => {
            const target = Math.max(0, Math.min(dots.length - 1, i));
            track.scrollTo({left: target * step(), behavior: "smooth"});
        };

        const sync = () => {
            const i = current();
            dots.forEach((dot, n) => dot.setAttribute("aria-current", String(n === i)));
        };

        gallery.querySelector("[data-prev]")?.addEventListener("click", () => goTo(current() - 1));
        gallery.querySelector("[data-next]")?.addEventListener("click", () => goTo(current() + 1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

        let raf = 0;
        track.addEventListener(
            "scroll",
            () => {
                cancelAnimationFrame(raf);
                raf = requestAnimationFrame(sync);
            },
            {passive: true},
        );
    });
</script>
