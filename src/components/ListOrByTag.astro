---
import ArticleAndTagsLayout from "../layouts/ArticleAndTagsLayout.astro";
const { active } = Astro.props;
---
<ArticleAndTagsLayout active={active}>
    <div id="blog-list" data-tag={active ?? ""} class="contents">
        <div class="col-span-2 text-gray-400 py-8 text-center">加载中…</div>
    </div>
</ArticleAndTagsLayout>

<script>
    import { renderBlogList } from "../scripts/blogList";

    const container = document.getElementById("blog-list");
    if (container) {
        renderBlogList(container);
    }
</script>
